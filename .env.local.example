# Veil — Miden devnet configuration (template)
# Copy to .env.local. All endpoints are public (not secrets).

# Miden devnet RPC node.
NEXT_PUBLIC_MIDEN_RPC_URL=https://rpc.devnet.miden.io

# PSM / Guardian coordination endpoint.
# The multisig SDK config key is `guardianEndpoint`; both vars below map to it.
#
# Two options:
#  - Self-hosted local Guardian (recommended for dev — the hosted staging
#    endpoint has been unreliable). Clone github.com/OpenZeppelin/guardian and
#    run `docker compose up --build -d` → HTTP on :3000. See build-on-miden skill.
#  - Hosted staging: https://psm-stg.openzeppelin.com (verify it's live first).
NEXT_PUBLIC_PSM_ENDPOINT=http://localhost:3000
NEXT_PUBLIC_GUARDIAN_ENDPOINT=http://localhost:3000
